---
// HERO — Enterprise White & Red Theme
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-white">

  <!-- Subtle radial red glow at top -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(220,38,38,0.06) 0%, transparent 70%);"></div>

  <!-- Soft architectural grid background texture -->
  <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(15,23,42,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,0.03) 1px, transparent 1px); background-size: 48px 48px;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-36 pb-24 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- Left: Copy -->
      <div class="lg:col-span-7 space-y-7">

        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200">
          <img src="/images/bell-logo.png" alt="Bell" class="w-4 h-4 object-contain inline-block" />
          <span class="text-xs font-bold text-red-700 tracking-wide">Chicago Licensed Drainlayer &bull; 62 Years Family Owned</span>
        </div>

        <!-- Headline — Future Pacing framework -->
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold tracking-tight text-slate-950 leading-[1.08] sm:leading-[1.02]">
          When Your Sewer Fails,<br>
          <span class="font-display italic font-normal text-red-600">Every Hour Costs You.</span>
        </h1>

        <!-- Sub — PAS: Problem / Agitate -->
        <p class="text-lg leading-relaxed max-w-xl text-slate-600">
          Sewage backing up into your basement is not an ordinary plumbing clog — it is an active structural emergency. Most contractors run a 2-inch mechanical snake, collect their fee, and leave the root mass intact. We bring commercial 4,000 PSI hydro-jetters, diagnose with 4K video, and permanently resolve the line.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a href="tel:7736856644" class="btn-primary text-sm shadow-lg shadow-red-600/25" style="padding: 1rem 2rem; font-size: 0.9375rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
            Call 24/7: (773) 685-6644
          </a>
          <a href="#contact" class="btn-ghost text-sm">
            Request Service Online
          </a>
        </div>

        <!-- Trust strip — contractor credentials -->
        <div class="flex flex-wrap gap-3 pt-2">
          <div class="trust-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span class="text-slate-800">IL Lic. Drainlayer #055-043219</span>
          </div>
          <div class="trust-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span class="text-slate-800">35-Min Emergency Arrival</span>
          </div>
          <div class="trust-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
            <span class="text-slate-800">City Permit #058-198422</span>
          </div>
        </div>

      </div>

      <!-- Right: Real Field Installation Showcase Card -->
      <div class="lg:col-span-5 relative reveal" style="transition-delay: 0.15s;">

        <div class="relative rounded-2xl overflow-hidden bg-white border border-slate-200 shadow-2xl">

          <!-- Top status bar -->
          <div class="flex items-center justify-between px-5 py-3.5 bg-slate-50 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <span class="inline-flex w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm shadow-emerald-500/50"></span>
              <span class="font-mono text-xs font-bold tracking-wider uppercase text-slate-800">ACTUAL CHICAGO FIELD WORK</span>
            </div>
            <div class="flex items-center gap-2 font-mono text-xs">
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase bg-emerald-100 text-emerald-800 border border-emerald-300">
                PASSED INSPECTION
              </span>
            </div>
          </div>

          <!-- Real Image Container -->
          <div class="relative h-80 sm:h-96 overflow-hidden bg-slate-900 group">
            <img
              src="/images/hero-tankless.jpg"
              alt="Bradford White Infiniti Tankless System installed by Bell Drainage Co."
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <!-- Gradient vignette -->
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/20 pointer-events-none"></div>

            <!-- Floating verification badge on image -->
            <div class="absolute top-3 left-3 px-3 py-1.5 rounded-lg backdrop-blur-md bg-white/90 border border-white/40 shadow-md flex items-center gap-2">
              <img src="/images/bell-logo.png" alt="Bell" class="w-4 h-4 object-contain" />
              <span class="text-xs font-bold text-slate-900">Bradford White &bull; Infiniti Tankless</span>
            </div>

            <!-- Bottom Telemetry Card overlay on image -->
            <div class="absolute bottom-3 inset-x-3 rounded-xl p-3.5 backdrop-blur-md bg-slate-950/85 border border-white/10 text-white">
              <div class="flex items-center justify-between">
                <div>
                  <div class="text-xs font-bold flex items-center gap-2 text-white">
                    <span>Precision Copper &amp; Dual-Vent Setup</span>
                  </div>
                  <div class="text-[11px] mt-0.5 text-slate-300">
                    Installed &amp; Commissioned by Bell Drainage Co.
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-[10px] uppercase font-mono tracking-wider font-bold text-emerald-400">100% Code Compliant</div>
                  <div class="text-[10px] text-slate-400">City of Chicago</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Action Bar -->
          <div class="px-5 py-3.5 bg-white flex items-center justify-between gap-3 border-t border-slate-100">
            <div>
              <div class="text-xs font-bold text-slate-900">62-Year Master Craftsmanship</div>
              <div class="text-xs text-slate-500">Commercial &amp; Residential Service</div>
            </div>
            <a href="tel:7736856644" class="btn-primary text-xs" style="padding: 0.5rem 1rem; font-size: 0.75rem;">
              Call Ron &amp; Jimmy
            </a>
          </div>

        </div>

        <!-- Floating social proof badge -->
        <div class="absolute -bottom-5 -left-6 hidden sm:flex items-center gap-3 rounded-xl px-4 py-3 bg-white border border-slate-200 shadow-xl">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 bg-red-50 border border-red-200">
            <img src="/images/bell-logo.png" alt="Bell" class="w-5 h-5 object-contain" />
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">Authentic Chicago Field Work</div>
            <div class="text-xs text-slate-500">No Subcontractors &bull; Family Owned</div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-slate-400">
    <span class="text-[10px] tracking-widest uppercase font-bold text-slate-500">Scroll</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
  </div>

</section>
