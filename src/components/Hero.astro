---
// HERO — Problem-Agitate-Solve framework (Allen Sultanic)
// Full-bleed dark, cinematic, no emojis, enterprise copy
---

<section class="relative min-h-screen flex flex-col justify-center overflow-hidden noise-overlay" style="background: var(--obs);">

  <!-- Subtle radial glow — amber, bottom-left -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 10% 90%, rgba(200,146,42,0.08) 0%, transparent 70%);"></div>

  <!-- Grid lines background texture -->
  <div class="absolute inset-0 pointer-events-none" style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 40%, transparent 100%);"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-8 pt-32 pb-24 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center">

      <!-- Left: Copy -->
      <div class="lg:col-span-7 space-y-8">

        <!-- Eyebrow -->
        <div class="flex items-center gap-3">
          <div class="h-px w-8 line-sweep" style="background: var(--amber);"></div>
          <span class="eyebrow">Chicago's Licensed Drainlayer — Established 1955</span>
        </div>

        <!-- Headline — Future Pacing framework -->
        <h1 class="text-3xl sm:text-5xl lg:text-7xl font-black tracking-tight leading-[1.05] sm:leading-[0.95]">
          When Your Sewer Fails,<br>
          <span class="font-display italic font-normal" style="color: var(--amber);">Every Hour Costs You.</span>
        </h1>

        <!-- Sub — PAS: Problem / Agitate -->
        <p class="text-lg leading-relaxed max-w-xl" style="color: var(--slate-2);">
          Sewage backing up into your basement is not a plumbing problem. It is a structural failure developing beneath your property right now. Most Chicago contractors send a snake, collect their fee, and leave the root mass intact. Three weeks later, you are calling again.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href="tel:7736856644" class="btn-primary text-sm" style="padding: 1rem 2rem; font-size: 0.9375rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
            Call Now: (773) 685-6644
          </a>
          <a href="#contact" class="btn-ghost text-sm">
            Get a Free Estimate
          </a>
        </div>

        <!-- Trust strip — contractor credentials -->
        <div class="flex flex-wrap gap-3 pt-2">
          <div class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--amber); flex-shrink:0;"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Chicago Contractor Since 1955
          </div>
          <div class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--amber); flex-shrink:0;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            IL Lic. Drainlayer #055-043219
          </div>
          <div class="trust-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="color: var(--amber); flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            35-Min Average Arrival, Cook County
          </div>
        </div>

      </div>

      <!-- Right: Diagnostic HUD card — no emojis, all telemetry -->
      <div class="lg:col-span-5 relative">

        <!-- Outer glow -->
        <div class="absolute -inset-px rounded-xl pointer-events-none" style="background: linear-gradient(135deg, rgba(200,146,42,0.3), transparent 60%); border-radius: 0.75rem;"></div>

        <div class="relative rounded-xl overflow-hidden" style="background: var(--obs-lite); border: 1px solid var(--rule);">

          <!-- HUD top bar -->
          <div class="flex items-center justify-between px-4 py-3 border-b" style="border-color: var(--rule); background: rgba(255,255,255,0.02);">
            <div class="flex items-center gap-2">
              <span class="inline-flex w-2 h-2 rounded-full" style="background: #22c55e; box-shadow: 0 0 6px #22c55e;"></span>
              <span class="font-mono text-xs font-semibold tracking-widest uppercase" style="color: #22c55e;">BELL-CAM 4K — LIVE</span>
            </div>
            <div class="flex items-center gap-3 font-mono text-xs" style="color: var(--slate-1);">
              <span>DEPTH 8.4 FT</span>
              <span style="color: var(--rule);">|</span>
              <span style="color: var(--amber);">4,000 PSI</span>
            </div>
          </div>

          <!-- Camera view -->
          <div class="relative h-56 overflow-hidden" style="background: #000;">
            <img
              src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=800&q=80"
              alt="Sewer pipe interior camera view"
              class="w-full h-full object-cover opacity-60"
              style="filter: contrast(1.1) saturate(0.6);"
            />
            <!-- Grid scan overlay -->
            <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,168,100,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,168,100,0.04) 1px, transparent 1px); background-size: 20px 20px;"></div>
            <!-- Scan line -->
            <div class="absolute inset-x-0 h-0.5 scan-line" style="background: linear-gradient(90deg, transparent, rgba(0,255,100,0.6), transparent); top: 40%; animation: scan-anim 3s linear infinite;"></div>
            <!-- Target crosshair -->
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
              <div class="relative w-20 h-20 rounded-full" style="border: 1px solid rgba(0,255,100,0.25);">
                <div class="absolute w-14 h-14 rounded-full inset-3" style="border: 1px solid rgba(0,255,100,0.15);"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-1.5 h-1.5 rounded-full" style="background: rgba(0,255,100,0.6);"></div>
                </div>
              </div>
            </div>
            <!-- Telemetry labels -->
            <div class="absolute top-3 left-3 font-mono text-xs px-2 py-1 rounded" style="background: rgba(0,0,0,0.65); color: rgba(0,255,100,0.9); border: 1px solid rgba(0,255,100,0.2);">
              GRADE −2.1% &nbsp; GRADE OK
            </div>
            <div class="absolute bottom-3 inset-x-3 rounded-lg px-3 py-2.5" style="background: rgba(0,0,0,0.75); border: 1px solid rgba(255,255,255,0.08);">
              <div class="flex items-center justify-between">
                <div>
                  <div class="font-mono text-xs font-bold" style="color: white;">Root Mass — 42.6 ft</div>
                  <div class="font-mono text-xs mt-0.5" style="color: var(--amber);">Cleared via Hydro-Jet 4,000 PSI</div>
                </div>
                <div class="text-xs font-bold px-2 py-1 rounded" style="background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3);">PASS</div>
              </div>
            </div>
          </div>

          <!-- Bottom dispatch strip -->
          <div class="px-4 py-3 flex items-center justify-between gap-3">
            <div>
              <div class="text-xs font-bold" style="color: white;">Unit 14 — En Route to Lakeview</div>
              <div class="text-xs mt-0.5" style="color: var(--slate-1);">Mainline blockage — ETA 18 min</div>
            </div>
            <a href="tel:7736856644" class="btn-primary text-xs" style="padding: 0.5rem 1rem; font-size: 0.75rem;">
              Dispatch
            </a>
          </div>

        </div>

        <!-- Floating social proof card -->
        <div class="absolute -bottom-5 -left-6 hidden sm:flex items-center gap-3 rounded-xl px-4 py-3 shadow-2xl" style="background: var(--obs-lite); border: 1px solid var(--rule); backdrop-filter: blur(16px);">
          <div class="w-9 h-9 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(34,197,94,0.1); border: 1px solid rgba(34,197,94,0.3);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <div>
            <div class="text-xs font-bold" style="color: white;">Line Restored — 44 min total</div>
            <div class="text-xs" style="color: var(--slate-1);">Lincoln Park, Chicago</div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-indicator flex flex-col items-center gap-2" style="color: var(--slate-1);">
    <span class="text-xs tracking-widest uppercase font-medium" style="font-size: 0.6rem;">Scroll</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
  </div>

</section>

<style>
@keyframes scan-anim {
  0% { top: 10%; }
  100% { top: 90%; }
}
</style>
