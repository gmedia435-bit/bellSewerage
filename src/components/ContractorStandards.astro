---
// CONTRACTOR STANDARDS & FIELD COMMITMENTS — White Theme, 62-Year Heritage
const standards = [
  {
    num: "01",
    title: "Licensed City of Chicago Drainlayer",
    body: "In Chicago, working on sewer laterals connecting to the municipal main requires a specialized City Drainlayer License (#055-043219). We hold the required bonds, pull the permits, and coordinate required city inspections. General handymen and unlicensed plumbers cannot legally perform this work."
  },
  {
    num: "02",
    title: "Upfront Written Pricing Before Work Begins",
    body: "We do not believe in open-ended hourly estimates or mid-job price surprises. Once we inspect the problem, we provide a clear, written flat-rate scope. You approve the exact cost before our crews start their equipment."
  },
  {
    num: "03",
    title: "Documented 4K Video Verification",
    body: "We never ask property owners to take our word for what is happening underground. Every diagnosis and completion is recorded with our self-leveling color cameras. You receive the full timestamped digital video file for your records and insurance."
  },
  {
    num: "04",
    title: "Heavy Commercial Contractor Equipment",
    body: "We do not carry homeowner-grade consumer cables. Our fleet operates 4,000 PSI high-pressure water jetters, commercial root-cutting augers, and pneumatic trenchless lining rigs capable of restoring 4-inch to 12-inch commercial and residential lines."
  },
  {
    num: "05",
    title: "Job Site Cleanliness & Property Protection",
    body: "Sewer and drain work is messy, but your home should never reflect it. Our technicians lay protective runners, seal off cleanout access points, and sanitize the work zone thoroughly before loading back into our trucks."
  },
  {
    num: "06",
    title: "Local Northwest Side Shop & 62-Year Accountability",
    body: "We are not a national franchise or an out-of-state dispatch service. Bell Drainage is a proud 62 years family owned and operated business. Our office and equipment yard are located at 6057 W Addison St. When you call us, you speak directly to local owners and dispatchers who know Chicago plumbing architecture inside and out."
  }
];
---

<section id="standards" class="py-20 md:py-28 border-t border-slate-200 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-10 mb-12 md:mb-16">
      <div class="space-y-4 reveal">
        <span class="eyebrow">Our Field Standards</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-slate-900">
          How a Real Contractor<br>
          <span class="text-red-gradient font-display italic font-normal">Treats Your Property.</span>
        </h2>
      </div>
      <div class="flex items-end reveal" style="transition-delay:0.1s;">
        <p class="text-base leading-relaxed text-slate-600">
          No marketing fluff, no fabricated testimonials. We build trust through verified city licensure, written contracts, commercial-grade field machinery, and documented video proof on every single call.
        </p>
      </div>
    </div>

    <!-- FULL 3-COL RESPONSIVE GRID -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {standards.map((s, i) => (
        <div class="bg-white rounded-xl border border-slate-200 p-7 shadow-xs hover:shadow-md hover:border-red-500 transition-all duration-200 flex flex-col justify-between space-y-4 reveal" style={`transition-delay: ${i * 0.05}s;`}>
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">{s.num}</span>
              <div class="w-2 h-2 rounded-full bg-red-500"></div>
            </div>
            <h3 class="text-lg font-bold leading-snug text-slate-900">{s.title}</h3>
            <p class="text-sm leading-relaxed mt-2 text-slate-600">{s.body}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
