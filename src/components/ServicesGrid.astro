---
// SERVICES GRID — White Theme with Red Accents, Desktop 3-Col Grid & Mobile Swipe Rail
const services = [
  {
    num: "01",
    title: "High-Pressure Hydro-Jetting",
    sub: "4,000 PSI — Full pipe restoration",
    body: "A mechanical snake creates a 2-inch channel through a clog. Hydro-jetting at 4,000 PSI removes everything from the pipe wall — grease, scale, root tendrils — restoring full bore diameter. No residue left to catch the next problem.",
    tags: ["Residential", "Commercial", "Grease Lines"],
  },
  {
    num: "02",
    title: "Trenchless Sewer Relining",
    sub: "CIPP epoxy — Zero excavation",
    body: "We install a seamless structural sleeve inside your existing pipe without touching your lawn, driveway, or sidewalk. The cured-in-place epoxy liner carries a 50-year structural warranty and permanently eliminates root entry at every joint.",
    tags: ["Clay Pipe", "Cast Iron", "No Dig"],
  },
  {
    num: "03",
    title: "4K Color Camera Inspection",
    sub: "Full diagnostic — Video file delivered",
    body: "Before we recommend any repair, we run a self-leveling 4K camera through your lateral line. You receive a time-stamped digital video file and a written report with exact depths. No guesswork, no upselling repairs you do not need.",
    tags: ["Residential", "Pre-Purchase", "Commercial"],
  },
  {
    num: "04",
    title: "Overhead Sewer Conversion",
    sub: "City of Chicago flood defense",
    body: "Chicago's combined municipal sewer system surcharges during heavy rain events, forcing raw sewage backward into basement floor drains. An overhead conversion re-routes your basement plumbing above the flood level permanently. We handle all city permits.",
    tags: ["Basement Flooding", "City Rebate Eligible"],
  },
  {
    num: "05",
    title: "Emergency Mainline Clearance",
    sub: "24-Hour dispatch — Flat-rate pricing",
    body: "When sewage is actively entering your home, the clock is running. Our fully equipped vans carry both mechanical cables and hydro-jetting equipment so the job gets finished, not patched. No overtime charges. No second trip.",
    tags: ["24/7", "Residential", "Commercial"],
  },
  {
    num: "06",
    title: "Sump & Ejector Pump Systems",
    sub: "Battery backup — Smart monitoring",
    body: "Chicago storms knock out grid power during the heaviest rainfall. Our dual-redundant battery backup systems pump 2,400 GPH for 72 continuous hours. Wi-Fi monitoring alerts your phone before water reaches the sump pit floor.",
    tags: ["Basement Protection", "Battery Backup"],
  },
];
---

<section id="services" class="py-20 md:py-28 overflow-hidden bg-white border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-10 mb-12 md:mb-16">
      <div class="lg:col-span-7 space-y-4 reveal">
        <span class="eyebrow">What We Do</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-slate-900">
          Precision Sewer &amp; Drain<br>
          <span class="text-red-gradient font-display italic font-normal">Engineered for Chicago's Infrastructure</span>
        </h2>
        <p class="text-base leading-relaxed max-w-lg text-slate-600">
          Chicago's clay-pipe laterals and combined storm-sewer system create failure modes that general plumbers are not equipped to solve. Every service below is performed by licensed drainlayers using commercial-grade diagnostic and repair equipment.
        </p>
      </div>
      <div class="lg:col-span-5 flex items-end reveal" style="transition-delay:0.15s;">
        <a href="#contact" class="btn-primary w-full sm:w-auto">
          Schedule Diagnostic Inspection
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Mobile Swipe Cue -->
    <div class="flex items-center justify-between md:hidden mb-4 text-xs text-slate-500">
      <span class="flex items-center gap-1.5 font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #DC2626;"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Swipe services horizontally
      </span>
      <span id="service-page-indicator" class="font-mono text-xs font-bold text-red-600">1 / 6</span>
    </div>

    <!-- Mobile Touch Rail / Desktop 3-Col Grid -->
    <div id="services-container" class="flex overflow-x-auto md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 pb-4 md:pb-0 scroll-smooth snap-x snap-mandatory">
      {services.map((s, i) => (
        <div class="w-[85vw] sm:w-[70vw] md:w-auto flex-shrink-0 snap-start bg-white rounded-xl border border-slate-200 p-7 shadow-xs hover:shadow-lg hover:border-red-500 transition-all duration-300 flex flex-col justify-between reveal" style={`transition-delay: ${i * 0.05}s;`}>
          <div>
            <!-- Number + Red indicator -->
            <div class="flex items-start justify-between mb-4">
              <span class="font-mono text-xs font-bold text-red-600 bg-red-50 px-2 py-0.5 rounded">{s.num}</span>
              <div class="w-2 h-2 rounded-full bg-red-500"></div>
            </div>
            <h3 class="text-lg font-bold mb-1 leading-snug text-slate-900">{s.title}</h3>
            <div class="text-xs font-bold mb-3 text-red-600">{s.sub}</div>
            <p class="text-sm leading-relaxed mb-6 text-slate-600">{s.body}</p>
          </div>
          <!-- Tags -->
          <div class="flex flex-wrap gap-2 pt-4 border-t border-slate-100">
            {s.tags.map(tag => (
              <span class="text-[11px] px-2.5 py-0.5 rounded-full font-medium bg-slate-50 text-slate-700 border border-slate-200">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const sContainer = document.getElementById('services-container');
  const sIndicator = document.getElementById('service-page-indicator');
  sContainer?.addEventListener('scroll', () => {
    if (!sIndicator) return;
    const cardWidth = sContainer.firstElementChild?.clientWidth || 300;
    const scrollLeft = sContainer.scrollLeft;
    const activeIndex = Math.min(6, Math.max(1, Math.round(scrollLeft / cardWidth) + 1));
    sIndicator.textContent = `${activeIndex} / 6`;
  }, { passive: true });
</script>
