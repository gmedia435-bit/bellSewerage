---
// REAL JOB SITE GALLERY — Authentic Chicago Field Work Proof, White Theme
const projects = [
  {
    title: "Bradford White Infiniti Tankless System",
    category: "High-Efficiency Water Heating",
    location: "Chicago, IL",
    image: "/images/bradford-tankless.jpg",
    desc: "Custom residential installation featuring dual copper manifolds, precision shut-off valves, and high-volume PVC power ventilation."
  },
  {
    title: "Basement Overhead Sewer Conversion",
    category: "Basement Flood Protection",
    location: "Northwest Side, Chicago",
    image: "/images/basement-overhead-excavation.jpg",
    desc: "Active concrete slab excavation and sub-floor piping for city-rebate overhead conversion, stopping municipal backup permanently."
  },
  {
    title: "Exterior Yard Drainage & Catch Basin",
    category: "Stormwater Management",
    location: "Cook County, IL",
    image: "/images/yard-drainage-trench.jpg",
    desc: "Deep trenching and green access basin installation with surgical sod removal and lawn preservation."
  },
  {
    title: "Lateral Line Replacement & Trenching",
    category: "Sewer Line Restoration",
    location: "Chicago, IL",
    image: "/images/exterior-sewer-line.jpg",
    desc: "Sewer lateral trenching along brick residential foundation with clean alignment and grade verification."
  }
];
---

<section id="gallery" class="py-20 md:py-28 border-t border-slate-200 bg-slate-50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 mb-12 md:mb-16 items-end">
      <div class="lg:col-span-7 space-y-4 reveal">
        <span class="eyebrow">Field Proof</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight text-slate-900">
          Actual Job Sites.<br>
          <span class="text-red-gradient font-display italic font-normal">Real Chicago Craftsmanship.</span>
        </h2>
        <p class="text-base leading-relaxed max-w-xl text-slate-600">
          No stock photography. No third-party contractor photos. These are real Chicago homes and businesses serviced by our master plumbers Ron, Jimmy, and the Bell Drainage crew.
        </p>
      </div>

      <div class="lg:col-span-5 flex lg:justify-end reveal" style="transition-delay: 0.15s;">
        <div class="inline-flex items-center gap-3 p-4 rounded-xl bg-white border border-slate-200 shadow-sm">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-red-50 border border-red-200">
            <img src="/images/bell-logo.png" alt="Bell" class="w-6 h-6 object-contain" />
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900">62 Years of Local Work</div>
            <div class="text-xs text-slate-500">Cook County Licensed &amp; Permitted</div>
          </div>
        </div>
      </div>
    </div>

    <!-- FULL 4-COL RESPONSIVE GRID — All 4 photos immediately visible -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {projects.map((p, i) => (
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md hover:border-red-500 transition-all duration-300 overflow-hidden flex flex-col justify-between group reveal" style={`transition-delay: ${i * 0.08}s;`}>
          <!-- Image -->
          <div class="relative h-64 overflow-hidden bg-slate-900">
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
            
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded text-[10px] font-bold tracking-wider uppercase backdrop-blur-md bg-white/90 text-red-600 border border-white/50 shadow-xs">
              {p.location}
            </div>

            <div class="absolute bottom-3 left-3 right-3">
              <span class="text-[11px] font-mono tracking-wider uppercase font-bold text-white drop-shadow-sm">{p.category}</span>
            </div>
          </div>

          <!-- Content -->
          <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
            <div>
              <h3 class="text-base font-bold text-slate-900 group-hover:text-red-600 transition-colors">{p.title}</h3>
              <p class="text-xs leading-relaxed mt-2 text-slate-600">{p.desc}</p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="font-semibold text-slate-500">Installed by Bell Crew</span>
              <span class="font-bold flex items-center gap-1 text-emerald-600">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                Verified
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
