---
// TRENCHLESS SECTION — Chicago-specific, enterprise, Sultanic future pacing
---

<section id="trenchless" class="py-20 md:py-28 border-t" style="background: var(--obs); border-color: var(--rule);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <!-- Right column first on desktop for visual variety -->
      <div class="lg:col-span-7 order-2 lg:order-1 reveal-left">

        <!-- Main visual -->
        <div class="relative rounded-xl overflow-hidden shadow-2xl" style="border: 1px solid var(--rule);">
          <img
            src="/images/basement-overhead-excavation.jpg"
            alt="Actual Chicago basement overhead sewer conversion and drain tile excavation by Bell Drainage Co."
            class="w-full object-cover h-72 sm:h-96 md:h-[420px]"
            style="filter: contrast(1.05) brightness(0.85);"
          />
          <div class="absolute inset-0" style="background: linear-gradient(45deg, rgba(12,15,26,0.85) 0%, transparent 60%);"></div>

          <!-- Real Field Work Badge -->
          <div class="absolute top-4 left-4 px-3 py-1.5 rounded text-xs font-bold tracking-wider uppercase backdrop-blur-md flex items-center gap-2" style="background: rgba(11,14,23,0.85); border: 1px solid rgba(255,255,255,0.15); color: white;">
            <img src="/images/bell-logo.png" alt="Bell" class="w-4 h-4 object-contain" />
            <span>Actual Chicago Job Site &bull; Overhead Sewer Excavation</span>
          </div>

          <!-- Overlay stats -->
          <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 right-4 sm:right-6">
            <div class="grid grid-cols-3 gap-2 sm:gap-3">
              <div class="p-2 sm:p-3 rounded-lg text-center" style="background: rgba(12,15,26,0.85); border: 1px solid var(--rule); backdrop-filter: blur(8px);">
                <div class="text-lg sm:text-xl font-black" style="color: var(--amber);">50yr</div>
                <div class="text-[11px] sm:text-xs mt-0.5" style="color: var(--slate-1);">Structural warranty</div>
              </div>
              <div class="p-2 sm:p-3 rounded-lg text-center" style="background: rgba(12,15,26,0.85); border: 1px solid var(--rule); backdrop-filter: blur(8px);">
                <div class="text-lg sm:text-xl font-black" style="color: var(--amber);">1 Day</div>
                <div class="text-[11px] sm:text-xs mt-0.5" style="color: var(--slate-1);">Install to cure</div>
              </div>
              <div class="p-2 sm:p-3 rounded-lg text-center" style="background: rgba(12,15,26,0.85); border: 1px solid var(--rule); backdrop-filter: blur(8px);">
                <div class="text-lg sm:text-xl font-black" style="color: var(--amber);">$0</div>
                <div class="text-[11px] sm:text-xs mt-0.5" style="color: var(--slate-1);">Excavation cost</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Chicago rebate callout -->
        <div class="mt-5 p-5 rounded-xl flex items-start gap-4" style="background: rgba(200,146,42,0.06); border: 1px solid rgba(200,146,42,0.2);">
          <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: rgba(200,146,42,0.1); border: 1px solid rgba(200,146,42,0.25);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" style="color: var(--amber);"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/></svg>
          </div>
          <div>
            <div class="text-sm font-bold mb-1" style="color: white;">City of Chicago — Flood Rebate Program</div>
            <div class="text-xs leading-relaxed" style="color: var(--slate-2);">
              Qualifying overhead sewer conversions are eligible for up to $4,000 in City of Chicago Department of Water Management rebates. We prepare and submit all required documentation on your behalf.
            </div>
          </div>
        </div>

      </div>

      <!-- Left text column -->
      <div class="lg:col-span-5 order-1 lg:order-2 space-y-6 reveal-right" style="transition-delay: 0.1s;">
        <span class="eyebrow">Trenchless Pipe Lining</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight">
          A New Pipe,<br>
          <span class="text-amber-gradient font-display italic font-normal">Without Touching Your Property.</span>
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--slate-2);">
          Traditional excavation quotes for a cracked sewer lateral in Chicago run $12,000 to $24,000. That includes breaking your concrete sidewalk, cutting through your front yard, and paying the city to restore the parkway.
        </p>
        <p class="text-base leading-relaxed" style="color: var(--slate-2);">
          Trenchless CIPP relining installs a structurally independent epoxy sleeve inside your existing pipe — through existing cleanout access only. When cured, it is watertight at every joint. Tree roots cannot penetrate it. The warranty transfers when you sell the property.
        </p>

        <!-- Process steps -->
        <div class="space-y-4 pt-2">
          {[
            { n: "1", title: "Camera Assessment", desc: "Full 4K inspection to determine pipe condition, dimensions, and access points." },
            { n: "2", title: "Hydro-Jetting Prep", desc: "4,000 PSI cleaning removes all debris so the liner bonds properly to the host pipe." },
            { n: "3", title: "Liner Installation", desc: "Epoxy-saturated liner is pulled through and inflated. Curing begins immediately." },
            { n: "4", title: "Post-Camera Verification", desc: "Final 4K pass confirms full seating and watertight bond before we leave." },
          ].map(step => (
            <div class="flex items-start gap-4">
              <span class="w-7 h-7 rounded-full text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5" style="background: rgba(200,146,42,0.12); border: 1px solid rgba(200,146,42,0.3); color: var(--amber);">{step.n}</span>
              <div>
                <div class="text-sm font-semibold mb-0.5" style="color: white;">{step.title}</div>
                <div class="text-xs" style="color: var(--slate-1);">{step.desc}</div>
              </div>
            </div>
          ))}
        </div>

        <a href="#contact" class="btn-primary inline-flex">
          Get a Free Trenchless Estimate
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>
</section>
