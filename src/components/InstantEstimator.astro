---
// LEAD CAPTURE FORM — GHL Integration-ready, enterprise styling
// This section is the primary conversion engine
---

<section id="contact" class="py-20 md:py-28 border-t relative overflow-hidden" style="border-color: var(--rule); background: var(--obs-mid);">

  <!-- Amber glow -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 50% 100%, rgba(200,146,42,0.07) 0%, transparent 70%);"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <!-- Left: Urgency copy -->
      <div class="lg:col-span-5 space-y-6 reveal">
        <span class="eyebrow">Request Service</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight">
          Describe the Problem.<br>
          <span class="text-amber-gradient font-display italic font-normal">We Handle the Rest.</span>
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--slate-2);">
          Complete the form and a licensed drainlayer will contact you within 15 minutes during business hours, or within 45 minutes for emergency dispatch requests. No call centers, no answering services — the person who schedules your job is the same person who runs it.
        </p>

        <!-- Contact details -->
        <div class="space-y-5 pt-4 border-t" style="border-color: var(--rule);">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: var(--obs-lite); border: 1px solid var(--rule);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" style="color: var(--amber);"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
            </div>
            <div>
              <div class="text-xs font-semibold tracking-wider uppercase mb-0.5" style="color: var(--slate-1);">24-Hour Emergency Line</div>
              <a href="tel:7736856644" class="text-xl font-black" style="color: white; text-decoration: none;">(773) 685-6644</a>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: var(--obs-lite); border: 1px solid var(--rule);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" style="color: var(--amber);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div class="text-xs font-semibold tracking-wider uppercase mb-0.5" style="color: var(--slate-1);">Office Address</div>
              <div class="text-sm font-semibold" style="color: white;">6057 W Addison St, Chicago, IL 60634</div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background: var(--obs-lite); border: 1px solid var(--rule);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" style="color: var(--amber);"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <div class="text-xs font-semibold tracking-wider uppercase mb-0.5" style="color: var(--slate-1);">Hours</div>
              <div class="text-sm font-semibold" style="color: white;">Open 24 Hours, 7 Days</div>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="pt-5 border-t" style="border-color: var(--rule);">
          <div class="text-xs font-semibold tracking-widest uppercase mb-3" style="color: var(--slate-1);">Credentials</div>
          <div class="space-y-2">
            <div class="text-xs" style="color: var(--slate-2);">IL Licensed Drainlayer — #055-043219</div>
            <div class="text-xs" style="color: var(--slate-2);">City of Chicago Permit #058-198422</div>
            <div class="text-xs" style="color: var(--slate-2);">NASSCO PACP Certified Pipeline Inspector</div>
            <div class="text-xs" style="color: var(--slate-2);">Family-Owned — Chicago, Since 1955</div>
          </div>
        </div>

      </div>

      <!-- Right: GHL-ready form -->
      <div class="lg:col-span-7 reveal" style="transition-delay: 0.15s;">
        <div class="rounded-xl p-6 sm:p-10" style="background: var(--obs-lite); border: 1px solid var(--rule);">

          <div class="mb-8">
            <h3 class="text-xl font-bold mb-1" style="color: white;">Request a Service Call</h3>
            <p class="text-sm" style="color: var(--slate-1);">We respond within 15 minutes during business hours. Mention if this is a basement-active emergency and we dispatch immediately.</p>
          </div>

          <!-- GHL Form — replace action URL with actual GHL form endpoint -->
          <form id="contact-form" class="space-y-5" action="#" method="POST">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">First Name</label>
                <input type="text" name="first_name" required placeholder="Michael" class="input-field" />
              </div>
              <div>
                <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Last Name</label>
                <input type="text" name="last_name" required placeholder="O'Brien" class="input-field" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Phone Number</label>
                <input type="tel" name="phone" required placeholder="(773) 555-0199" class="input-field" />
              </div>
              <div>
                <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Email Address</label>
                <input type="email" name="email" placeholder="michael@email.com" class="input-field" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Service Address</label>
              <input type="text" name="address" required placeholder="6057 W Addison St, Chicago, IL" class="input-field" />
            </div>

            <div>
              <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Service Needed</label>
              <select name="service" class="input-field" style="cursor: pointer;">
                <option value="" disabled selected style="background: #1E2438; color: #8A93A8;">Select a service...</option>
                <option value="emergency" style="background: #1E2438;">Emergency Mainline Backup</option>
                <option value="hydro" style="background: #1E2438;">Hydro-Jetting (4,000 PSI)</option>
                <option value="camera" style="background: #1E2438;">Camera Inspection / Diagnostic</option>
                <option value="trenchless" style="background: #1E2438;">Trenchless Sewer Relining</option>
                <option value="overhead" style="background: #1E2438;">Overhead Sewer Conversion</option>
                <option value="sump" style="background: #1E2438;">Sump / Ejector Pump System</option>
                <option value="other" style="background: #1E2438;">Other / Not Sure</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold tracking-wide uppercase mb-2" style="color: var(--slate-1);">Describe the Issue</label>
              <textarea name="message" rows="4" placeholder="When did this start? Is sewage actively entering the building? Any prior service on this line?" class="input-field resize-none"></textarea>
            </div>

            <!-- Emergency toggle -->
            <div class="flex items-center gap-3 p-4 rounded-lg" style="background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.15);">
              <input type="checkbox" name="emergency" id="emergency-check" class="w-4 h-4 rounded" style="accent-color: #ef4444;" />
              <label for="emergency-check" class="text-sm font-semibold cursor-pointer" style="color: white;">
                This is an active emergency — sewage is entering the building now
              </label>
            </div>

            <button type="submit" class="btn-primary w-full" style="padding: 1.1rem 2rem; font-size: 1rem; justify-content: center;">
              Submit Service Request
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>

            <p class="text-xs text-center" style="color: var(--slate-1);">
              Your information is never sold or shared. By submitting, you agree to be contacted by Bell Sewerage & Drainage Co. regarding your service request.
            </p>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = (e.currentTarget as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
    if (!btn) return;
    btn.textContent = 'Request Submitted — We will contact you shortly.';
    btn.style.background = 'rgba(34,197,94,0.15)';
    btn.style.color = '#22c55e';
    btn.style.border = '1px solid rgba(34,197,94,0.3)';
    btn.disabled = true;
  });
</script>
