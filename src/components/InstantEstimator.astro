---
// LEAD CAPTURE FORM — White Theme, GHL Integration-ready
---

<section id="contact" class="py-20 md:py-28 border-t border-slate-200 bg-white relative overflow-hidden">

  <!-- Subtle red background glow -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 60% at 50% 100%, rgba(220,38,38,0.05) 0%, transparent 70%);"></div>

  <div class="max-w-7xl mx-auto px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <!-- Left: Urgency copy -->
      <div class="lg:col-span-5 space-y-6 reveal">
        <span class="eyebrow">Request Service</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900">
          Describe the Problem.<br>
          <span class="text-red-gradient font-display italic font-normal">We Handle the Rest.</span>
        </h2>
        <p class="text-base leading-relaxed text-slate-600">
          Complete the form and a licensed drainlayer will contact you within 15 minutes during business hours, or within 45 minutes for emergency dispatch requests. No call centers, no answering services — the person who schedules your job is the same person who runs it.
        </p>

        <!-- Contact details (White Cards) -->
        <div class="space-y-4 pt-4 border-t border-slate-200">
          <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-red-50 border border-red-200">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
            </div>
            <div>
              <div class="text-[10px] font-bold tracking-wider uppercase text-slate-500 mb-0.5">24-Hour Emergency Line</div>
              <a href="tel:7736856644" class="text-xl font-black text-red-600 hover:text-red-700 transition-colors">(773) 685-6644</a>
            </div>
          </div>

          <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-red-50 border border-red-200">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <div class="text-[10px] font-bold tracking-wider uppercase text-slate-500 mb-0.5">Office &amp; Yard</div>
              <div class="text-sm font-bold text-slate-900">6057 W Addison St, Chicago, IL 60634</div>
            </div>
          </div>

          <div class="flex items-center gap-4 p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-red-50 border border-red-200">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <div class="text-[10px] font-bold tracking-wider uppercase text-slate-500 mb-0.5">Operating Hours</div>
              <div class="text-sm font-bold text-slate-900">Open 24 Hours, 7 Days a Week</div>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="pt-4 border-t border-slate-200">
          <div class="text-xs font-bold tracking-widest uppercase mb-3 text-slate-500">Credentials</div>
          <div class="space-y-1.5 text-xs text-slate-600 font-medium">
            <div>&bull; IL Licensed Drainlayer — #055-043219</div>
            <div>&bull; City of Chicago Permit #058-198422</div>
            <div>&bull; NASSCO PACP Certified Pipeline Inspector</div>
            <div>&bull; A Proud 62 Years Family Owned &amp; Operated — Chicago, IL</div>
          </div>
        </div>

      </div>

      <!-- Right: GHL-ready form (White Card with Shadow) -->
      <div class="lg:col-span-7 reveal" style="transition-delay: 0.15s;">
        <div class="rounded-2xl p-7 sm:p-10 bg-white border border-slate-200 shadow-xl">

          <div class="mb-8">
            <h3 class="text-2xl font-black text-slate-900 mb-1">Request a Service Call</h3>
            <p class="text-sm text-slate-600">We respond within 15 minutes during business hours. Mention if this is an active emergency and we dispatch immediately.</p>
          </div>

          <!-- GHL Form -->
          <form id="contact-form" class="space-y-5" action="#" method="POST">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">First Name</label>
                <input type="text" name="first_name" required placeholder="Michael" class="input-field" />
              </div>
              <div>
                <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Last Name</label>
                <input type="text" name="last_name" required placeholder="O'Brien" class="input-field" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Phone Number</label>
                <input type="tel" name="phone" required placeholder="(773) 555-0199" class="input-field" />
              </div>
              <div>
                <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Email Address</label>
                <input type="email" name="email" placeholder="michael@email.com" class="input-field" />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Service Address</label>
              <input type="text" name="address" required placeholder="6057 W Addison St, Chicago, IL" class="input-field" />
            </div>

            <div>
              <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Service Needed</label>
              <select name="service" class="input-field cursor-pointer">
                <option value="" disabled selected>Select a service...</option>
                <option value="emergency">Emergency Mainline Backup</option>
                <option value="hydro">Hydro-Jetting (4,000 PSI)</option>
                <option value="camera">Camera Inspection / Diagnostic</option>
                <option value="trenchless">Trenchless Sewer Relining</option>
                <option value="overhead">Overhead Sewer Conversion</option>
                <option value="tankless">Water Heater / Tankless Installation</option>
                <option value="sump">Sump / Ejector Pump System</option>
                <option value="other">Other / Not Sure</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold tracking-wide uppercase mb-2 text-slate-700">Describe the Issue</label>
              <textarea name="message" rows="4" placeholder="When did this start? Is sewage actively entering the building? Any prior service on this line?" class="input-field resize-none"></textarea>
            </div>

            <!-- Emergency toggle -->
            <div class="flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200">
              <input type="checkbox" name="emergency" id="emergency-check" class="w-4 h-4 rounded accent-red-600" />
              <label for="emergency-check" class="text-sm font-bold text-red-900 cursor-pointer">
                This is an active emergency — sewage or water is actively flooding now
              </label>
            </div>

            <button type="submit" class="btn-primary w-full" style="padding: 1.1rem 2rem; font-size: 1rem; justify-content: center;">
              Submit Service Request
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>

            <p class="text-xs text-center text-slate-500">
              Your information is never sold or shared. By submitting, you agree to be contacted by Bell Drainage Co. regarding your service request.
            </p>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = (e.currentTarget as HTMLFormElement).querySelector('button[type="submit"]') as HTMLButtonElement;
    if (!btn) return;
    btn.textContent = 'Request Submitted — We will contact you shortly.';
    btn.style.background = '#16A34A';
    btn.style.color = '#FFFFFF';
    btn.disabled = true;
  });
</script>
