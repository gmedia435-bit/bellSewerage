---
// VERIFIED FACEBOOK REVIEWS — 100% Authentic, zero emojis, enterprise card layout
// Features mobile snap-swipe rail & desktop responsive grid
const reviews = [
  {
    name: "Dariusz Kraj",
    date: "January 2022",
    tag: "Fast Dispatch & Fair Pricing",
    text: "Fast, courteous & knowledgeable service with very reasonable prices. Highly recommend!!"
  },
  {
    name: "Kevin R. King",
    date: "August 2020",
    tag: "Master Technicians",
    text: "Ron and Jimmy are the best! Friendly, fair, patient, and experts in all that they do! I highly recommend Bell Drainage for all of your plumbing needs!"
  },
  {
    name: "Michael Gallivan",
    date: "April 2020",
    tag: "Owner Integrity",
    text: "Owner is First Class individual."
  },
  {
    name: "Anna Tuminello",
    date: "January 2020",
    tag: "45-Minute Arrival",
    text: "Ron came out within 45 minutes of my call! Very professional, friendly and understanding. He fixed my DIY mistakes too."
  },
  {
    name: "Mandy Jo",
    date: "February 2019",
    tag: "Sunday Emergency Call",
    text: "Thank you isn't enough! Job was done quickly and beyond fairly! He came out on a Sunday morning and was a pleasure to do business with! Knows what he's doing and didn't jerk me around. Highly recommend!"
  },
  {
    name: "Alisa Mayfield Conboy",
    date: "February 2019",
    tag: "Same-Day Frozen Pipe Burst",
    text: "Bell had our water flowing again SAME DAY after a frozen pipe burst. GREAT service and quality!"
  },
  {
    name: "Susan Fumo",
    date: "November 2017",
    tag: "Repeat Client",
    text: "I have used Bell Drainage in a number of occasions and have always been 100% satisfied! When it comes to plumbing issues, Bell Drainage is the ONLY company I will call on."
  },
  {
    name: "Jeff Dale",
    date: "November 2017",
    tag: "Direct Owner Service",
    text: "Great company. Ron unclogged my pipes personally. Great with bathroom additions too."
  },
  {
    name: "Stacy Nierman",
    date: "April 2017",
    tag: "Mainline Rodding",
    text: "GREAT JOB!!, rodding out this terrible clog in my bathroom/kitchen!!! Excellent and speedy service! Will definitely be using them again! THANKS SO MUCH!!"
  }
];
---

<section id="reviews" class="py-20 md:py-28 border-t overflow-hidden" style="background: var(--obs-mid); border-color: var(--rule);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Section Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 mb-12 md:mb-16 items-end">
      <div class="lg:col-span-7 space-y-4 reveal">
        <span class="eyebrow">Client Endorsements</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight">
          Recommended by Chicago Property Owners.<br>
          <span class="text-amber-gradient font-display italic font-normal">100% Verified Facebook Rating.</span>
        </h2>
        <p class="text-sm md:text-base leading-relaxed max-w-xl" style="color: var(--slate-2);">
          Unfiltered feedback directly from Chicago residents. When emergencies happen, our owner and master drainlayers respond in under 45 minutes, resolve frozen bursts the same day, and treat every home with honest contractor pricing.
        </p>
      </div>

      <!-- Trust Stat Callout -->
      <div class="lg:col-span-5 reveal" style="transition-delay: 0.15s;">
        <div class="p-6 rounded-xl flex items-center gap-5" style="background: var(--obs-lite); border: 1px solid var(--rule);">
          <div class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0" style="background: rgba(220,38,38,0.12); border: 1px solid rgba(220,38,38,0.3);">
            <!-- Official Red Bell / Facebook badge -->
            <img src="/images/bell-logo.png" alt="Bell" class="w-7 h-7 object-contain" />
          </div>
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xl font-black text-white">100% Recommend</span>
              <span class="text-xs px-2 py-0.5 rounded font-bold uppercase tracking-wider" style="background: rgba(34,197,94,0.15); color: #22c55e; border: 1px solid rgba(34,197,94,0.3);">Verified</span>
            </div>
            <div class="text-xs" style="color: var(--slate-1);">
              62 Years Serving Chicago &bull; 14 Verified Facebook Recommendations
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mobile Swipe Cue -->
    <div class="flex items-center justify-between md:hidden mb-4 text-xs" style="color: var(--slate-1);">
      <span class="flex items-center gap-1.5 font-medium">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--amber);"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Swipe reviews horizontally
      </span>
      <span id="reviews-page-indicator" class="font-mono text-xs" style="color: var(--amber);">1 / 9</span>
    </div>

    <!-- Mobile Touch-Swipeable Rail / Desktop 3-Col Grid -->
    <div id="reviews-container" class="snap-mobile-scroll md:grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map((r, i) => (
        <div class="snap-card w-[84vw] sm:w-[70vw] md:w-auto card-dark p-6 sm:p-7 flex flex-col justify-between reveal" style={`transition-delay: ${i * 0.05}s;`}>
          <div>
            <!-- Stars row + Verified tag -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-1">
                {[1, 2, 3, 4, 5].map(() => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--amber);"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                ))}
              </div>
              <span class="text-[10px] uppercase font-mono px-2 py-0.5 rounded tracking-wider" style="background: rgba(200,146,42,0.1); color: var(--amber); border: 1px solid rgba(200,146,42,0.25);">
                {r.tag}
              </span>
            </div>

            <!-- Review Body -->
            <p class="text-sm leading-relaxed mb-6 font-normal" style="color: var(--white); min-height: 4.5rem;">
              &ldquo;{r.text}&rdquo;
            </p>
          </div>

          <!-- Author details -->
          <div class="pt-4 border-t flex items-center justify-between" style="border-color: var(--rule);">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs" style="background: rgba(255,255,255,0.06); color: var(--amber); border: 1px solid var(--rule);">
                {r.name.charAt(0)}
              </div>
              <div>
                <div class="text-xs font-bold" style="color: white;">{r.name}</div>
                <div class="text-[11px]" style="color: var(--slate-1);">{r.date}</div>
              </div>
            </div>

            <div class="flex items-center gap-1.5 text-[11px] font-medium" style="color: var(--slate-1);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="color: #1877F2;"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              <span>Facebook</span>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Mobile reviews swipe tracker
  const revContainer = document.getElementById('reviews-container');
  const revIndicator = document.getElementById('reviews-page-indicator');
  
  revContainer?.addEventListener('scroll', () => {
    if (!revIndicator) return;
    const cardWidth = revContainer.firstElementChild?.clientWidth || 300;
    const scrollLeft = revContainer.scrollLeft;
    const activeIndex = Math.min(9, Math.max(1, Math.round(scrollLeft / cardWidth) + 1));
    revIndicator.textContent = `${activeIndex} / 9`;
  }, { passive: true });
</script>
