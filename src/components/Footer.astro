---
// FOOTER — Grounded Dark Slate Base for White Theme
---

<footer class="border-t border-slate-200 bg-slate-950 text-white">

  <!-- CTA Bar -->
  <div class="border-b border-slate-800 bg-slate-900">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-14">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="space-y-3">
          <h3 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            Sewer or drain issue right now?
          </h3>
          <p class="text-base text-slate-300">
            Our 24-hour dispatch line connects directly to licensed drainlayers Ron &amp; Jimmy — not an out-of-state call center. We prioritize active Chicago emergencies.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <a href="tel:7736856644" class="btn-primary" style="font-size: 1.0625rem; padding: 1rem 2rem;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
            (773) 685-6644
          </a>
          <a href="#contact" class="btn-ghost" style="background: rgba(255,255,255,0.06); color: white; border-color: rgba(255,255,255,0.2);">
            Request Service Online
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer body -->
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-14">

      <!-- Brand -->
      <div class="lg:col-span-1 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg p-1.5 flex items-center justify-center flex-shrink-0 bg-red-500/10 border border-red-500/20">
            <img src="/images/bell-logo.png" alt="Bell Drainage Co." class="h-7 w-auto object-contain" />
          </div>
          <div>
            <div class="text-base font-black text-white leading-none"><span style="color: #DC2626;">BELL</span> DRAINAGE</div>
            <div class="text-[11px] font-bold text-red-400 mt-1">A Proud 62 Years Family Owned</div>
          </div>
        </div>
        <p class="text-xs leading-relaxed text-slate-400">
          Chicago's licensed drainlayer for sewer repair, hydro-jetting, and trenchless pipe lining. A proud 62 years family owned and operated business in Chicago.
        </p>
        <div class="text-xs space-y-1 text-slate-400">
          <div>IL Drainlayer #055-043219</div>
          <div>Chicago Permit #058-198422</div>
        </div>
      </div>

      <!-- Services -->
      <div class="space-y-3">
        <div class="text-xs font-bold tracking-widest uppercase mb-4 text-slate-400">Services</div>
        <ul class="space-y-2">
          {["Hydro-Jetting (4,000 PSI)", "Trenchless Sewer Lining", "4K Camera Diagnostics", "Overhead Sewer Conversion", "Emergency Mainline Clearance", "Tankless Water Heating", "Sump Pump Systems"].map(s => (
            <li><a href="#services" class="text-xs text-slate-400 hover:text-white transition-colors">{s}</a></li>
          ))}
        </ul>
      </div>

      <!-- Areas -->
      <div class="space-y-3">
        <div class="text-xs font-bold tracking-widest uppercase mb-4 text-slate-400">Service Areas</div>
        <ul class="space-y-2">
          {["Lincoln Park", "Lakeview", "Logan Square", "West Loop", "Dunning & Belmont", "South Loop", "Hyde Park", "Oak Park", "Evanston"].map(a => (
            <li><a href="#coverage" class="text-xs text-slate-400 hover:text-white transition-colors">{a}</a></li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="space-y-4">
        <div class="text-xs font-bold tracking-widest uppercase mb-4 text-slate-400">Contact</div>
        <div class="space-y-3">
          <div>
            <div class="text-xs text-slate-400 mb-1">24-Hour Emergency</div>
            <a href="tel:7736856644" class="text-lg font-black text-white hover:text-red-400 transition-colors">(773) 685-6644</a>
          </div>
          <div>
            <div class="text-xs text-slate-400 mb-1">Office &amp; Yard</div>
            <div class="text-xs text-slate-300">6057 W Addison St<br>Chicago, IL 60634</div>
          </div>
          <div>
            <div class="text-xs text-slate-400 mb-1">Hours</div>
            <div class="text-xs text-slate-300">Open 24 Hours, 7 Days a Week</div>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom row -->
    <div class="pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-slate-500 text-xs">
      <div>
        &copy; {new Date().getFullYear()} Bell Drainage Co. All rights reserved. Licensed, Bonded &amp; Insured — Chicago, IL.
      </div>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>

</footer>
