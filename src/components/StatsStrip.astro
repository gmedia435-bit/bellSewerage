---
// STATS STRIP — Real contractor credentials & operational metrics, mobile-optimized
---

<section class="border-y" style="border-color: var(--rule); background: var(--obs-mid);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 md:py-14">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-0">

      <div class="flex flex-col items-center lg:items-start lg:pr-8 text-center lg:text-left space-y-1 reveal">
        <div class="text-3xl sm:text-5xl font-black stat-glow" style="color: #DC2626;">62 Yrs</div>
        <div class="text-xs sm:text-sm font-semibold" style="color: white;">Family Owned &amp; Operated</div>
        <div class="text-[11px] sm:text-xs" style="color: var(--slate-1);">Proud 62-year legacy in Chicago</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:px-8 text-center lg:text-left space-y-1 reveal lg:border-l" style="border-color: var(--rule); transition-delay: 0.1s;">
        <div class="text-3xl sm:text-5xl font-black stat-glow" style="color: #DC2626;">4,000</div>
        <div class="text-xs sm:text-sm font-semibold" style="color: white;">PSI Water Jetting</div>
        <div class="text-[11px] sm:text-xs" style="color: var(--slate-1);">Heavy commercial equipment</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:px-8 text-center lg:text-left space-y-1 reveal lg:border-l" style="border-color: var(--rule); transition-delay: 0.2s;">
        <div class="text-3xl sm:text-5xl font-black stat-glow" style="color: #DC2626;">#055</div>
        <div class="text-xs sm:text-sm font-semibold" style="color: white;">Licensed Drainlayer</div>
        <div class="text-[11px] sm:text-xs" style="color: var(--slate-1);">IL Lic #055-043219 & bonded</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:pl-8 text-center lg:text-left space-y-1 reveal lg:border-l" style="border-color: var(--rule); transition-delay: 0.3s;">
        <div class="text-3xl sm:text-5xl font-black stat-glow" style="color: #DC2626;">24/7</div>
        <div class="text-xs sm:text-sm font-semibold" style="color: white;">Emergency Field Crew</div>
        <div class="text-[11px] sm:text-xs" style="color: var(--slate-1);">Direct dispatch line</div>
      </div>

    </div>
  </div>
</section>
