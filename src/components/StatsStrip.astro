---
// STATS STRIP — White Theme with Brand Red Accents
---

<section class="border-y border-slate-200 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 md:py-14">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-0">

      <div class="flex flex-col items-center lg:items-start lg:pr-8 text-center lg:text-left space-y-1 reveal">
        <div class="text-3xl sm:text-5xl font-black text-red-600">62 Yrs</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900">Family Owned &amp; Operated</div>
        <div class="text-[11px] sm:text-xs text-slate-500">Proud 62-year legacy in Chicago</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:px-8 text-center lg:text-left space-y-1 reveal lg:border-l lg:border-slate-200" style="transition-delay: 0.1s;">
        <div class="text-3xl sm:text-5xl font-black text-red-600">4,000</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900">PSI Water Jetting</div>
        <div class="text-[11px] sm:text-xs text-slate-500">Heavy commercial field equipment</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:px-8 text-center lg:text-left space-y-1 reveal lg:border-l lg:border-slate-200" style="transition-delay: 0.2s;">
        <div class="text-3xl sm:text-5xl font-black text-red-600">#055</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900">Licensed Drainlayer</div>
        <div class="text-[11px] sm:text-xs text-slate-500">IL Lic #055-043219 &amp; bonded</div>
      </div>

      <div class="flex flex-col items-center lg:items-start lg:pl-8 text-center lg:text-left space-y-1 reveal lg:border-l lg:border-slate-200" style="transition-delay: 0.3s;">
        <div class="text-3xl sm:text-5xl font-black text-red-600">24/7</div>
        <div class="text-xs sm:text-sm font-bold text-slate-900">Emergency Field Crew</div>
        <div class="text-[11px] sm:text-xs text-slate-500">Direct owner &amp; crew dispatch</div>
      </div>

    </div>
  </div>
</section>
