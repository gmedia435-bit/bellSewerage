---
// BEFORE / AFTER SLIDER — Draggable, touch-ready, enterprise
---

<section id="inspection" class="py-20 md:py-28 border-t" style="background: var(--obs-mid); border-color: var(--rule);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <!-- Left: Copy -->
      <div class="lg:col-span-5 space-y-6 reveal-left">
        <span class="eyebrow">Camera Inspection</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight">
          You See Exactly<br>
          <span class="text-amber-gradient font-display italic font-normal">What We See.</span>
        </h2>
        <p class="text-base leading-relaxed" style="color: var(--slate-2);">
          We do not describe what is happening inside your lateral line. We show you. Every inspection delivers a full 4K color video file — time-stamped, depth-logged, and emailed to you before we leave the property.
        </p>
        <div class="space-y-4 pt-2">
          <div class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background: rgba(200,146,42,0.15); border: 1px solid rgba(200,146,42,0.3);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--amber);"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div class="text-sm font-semibold mb-0.5" style="color: white;">Radio-transmitter depth locating</div>
              <div class="text-xs" style="color: var(--slate-1);">Marks exact GPS coordinates of any break or root mass</div>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background: rgba(200,146,42,0.15); border: 1px solid rgba(200,146,42,0.3);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--amber);"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div class="text-sm font-semibold mb-0.5" style="color: white;">Written diagnostic report included</div>
              <div class="text-xs" style="color: var(--slate-1);">Required for city permit applications and insurance claims</div>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5" style="background: rgba(200,146,42,0.15); border: 1px solid rgba(200,146,42,0.3);">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="color: var(--amber);"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div>
              <div class="text-sm font-semibold mb-0.5" style="color: white;">Free with any mainline clearing</div>
              <div class="text-xs" style="color: var(--slate-1);">We document the before and after on every job</div>
            </div>
          </div>
        </div>
        <a href="#contact" class="btn-primary inline-flex">
          Schedule Inspection
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Right: Drag slider -->
      <div class="lg:col-span-7 reveal-right" style="transition-delay: 0.15s;">
        <div class="relative overflow-hidden rounded-xl select-none touch-none" id="ba-container" style="border: 1px solid var(--rule); aspect-ratio: 16/9; background: #000; cursor: ew-resize;">

          <!-- AFTER (behind) -->
          <div class="absolute inset-0">
            <img src="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?auto=format&fit=crop&w=1200&q=80"
              alt="After: restored sewer pipe interior" class="w-full h-full object-cover" style="opacity: 0.9; filter: contrast(1.05);" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 40%);"></div>
            <div class="absolute top-4 right-4 px-3 py-1.5 rounded text-xs font-bold tracking-wider uppercase" style="background: rgba(34,197,94,0.9); color: white; letter-spacing: 0.08em;">
              After — Full Flow Restored
            </div>
          </div>

          <!-- BEFORE (clipped foreground) -->
          <div class="absolute inset-0 overflow-hidden" id="ba-before" style="width: 50%;">
            <img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=1200&q=80"
              alt="Before: blocked sewer pipe with root intrusion" class="w-full h-full object-cover" style="width: 100%; max-width: none; opacity: 0.85; filter: saturate(0.7) contrast(1.1);" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 40%);"></div>
            <div class="absolute top-4 left-4 px-3 py-1.5 rounded text-xs font-bold tracking-wider uppercase" style="background: rgba(239,68,68,0.9); color: white; letter-spacing: 0.08em;">
              Before — Root Intrusion
            </div>
          </div>

          <!-- Divider handle -->
          <div id="ba-handle" class="absolute top-0 bottom-0 ba-handle" style="left: 50%; transform: translateX(-50%);">
            <div class="ba-pill">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="color: #0C0F1A;"><path d="M9 18l-6-6 6-6"/><path d="M15 6l6 6-6 6"/></svg>
            </div>
          </div>

          <!-- Hint -->
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 text-xs font-medium px-3 py-1.5 rounded-full" style="background: rgba(0,0,0,0.6); color: rgba(255,255,255,0.7); pointer-events: none; white-space: nowrap;">
            Drag or swipe to compare
          </div>

        </div>

        <!-- Legend row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-5">
          <div class="p-4 rounded-lg" style="background: rgba(239,68,68,0.06); border: 1px solid rgba(239,68,68,0.15);">
            <div class="text-xs font-bold mb-1" style="color: rgba(239,68,68,0.9);">Before — Clay Pipe Failure</div>
            <div class="text-xs" style="color: var(--slate-1);">Maple tree roots cracked the 6-inch joint at 42 ft, causing recurring basement backups</div>
          </div>
          <div class="p-4 rounded-lg" style="background: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.15);">
            <div class="text-xs font-bold mb-1" style="color: rgba(34,197,94,0.9);">After — CIPP Epoxy Relined</div>
            <div class="text-xs" style="color: var(--slate-1);">Seamless jointless liner installed in 6 hours. 50-year structural warranty. Zero excavation.</div>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  const container = document.getElementById('ba-container');
  const before = document.getElementById('ba-before');
  const handle = document.getElementById('ba-handle');
  let dragging = false;

  function move(x: number) {
    if (!container || !before || !handle) return;
    const rect = container.getBoundingClientRect();
    let p = Math.max(0.04, Math.min(0.96, (x - rect.left) / rect.width));
    const pct = p * 100;
    before.style.width = pct + '%';
    handle.style.left = pct + '%';
  }

  container?.addEventListener('mousedown', e => { dragging = true; move(e.clientX); });
  window.addEventListener('mousemove', e => { if (dragging) move(e.clientX); });
  window.addEventListener('mouseup', () => { dragging = false; });

  container?.addEventListener('touchstart', e => {
    dragging = true;
    if (e.touches[0]) move(e.touches[0].clientX);
  }, { passive: false });

  window.addEventListener('touchmove', e => {
    if (!dragging) return;
    if (e.touches[0]) {
      move(e.touches[0].clientX);
    }
  }, { passive: false });

  window.addEventListener('touchend', () => { dragging = false; });
  window.addEventListener('touchcancel', () => { dragging = false; });
</script>
