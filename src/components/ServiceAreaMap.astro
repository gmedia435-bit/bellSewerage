---
// SERVICE AREA — White Theme with Clean Neighborhood Cards
const zones = [
  { name: "Lincoln Park & Lakeview", zips: "60614, 60657" },
  { name: "Logan Square & Wicker Park", zips: "60647, 60622" },
  { name: "The Loop & River North", zips: "60601, 60654" },
  { name: "West Loop & Fulton Market", zips: "60607, 60661" },
  { name: "Dunning & Belmont Cragin", zips: "60634, 60639" },
  { name: "South Loop & Bridgeport", zips: "60605, 60608" },
  { name: "Hyde Park & Kenwood", zips: "60615, 60637" },
  { name: "Beverly & Mt. Greenwood", zips: "60643, 60655" },
  { name: "Evanston & Skokie", zips: "60201, 60076" },
  { name: "Oak Park & River Forest", zips: "60301, 60302" },
];
---

<section id="coverage" class="py-20 md:py-28 border-t border-slate-200 bg-slate-50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-4 space-y-5 reveal-left">
        <span class="eyebrow">Service Coverage</span>
        <h2 class="text-4xl sm:text-5xl font-black tracking-tight text-slate-900">
          Greater<br>
          <span class="text-red-gradient font-display italic font-normal">Chicagoland.</span>
        </h2>
        <p class="text-base leading-relaxed text-slate-600">
          Dispatch staging from our Northwest Side location allows us to cover all of Chicago and Cook County with an average 35-minute response time for emergency calls.
        </p>
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 mb-3">Average Response Time</div>
          <div class="flex justify-between text-sm font-semibold pb-2 border-b border-slate-100">
            <span class="text-slate-700">Chicago City</span>
            <span class="font-bold text-red-600">20–35 min</span>
          </div>
          <div class="flex justify-between text-sm font-semibold pb-2 border-b border-slate-100">
            <span class="text-slate-700">Near Suburbs</span>
            <span class="font-bold text-red-600">30–45 min</span>
          </div>
          <div class="flex justify-between text-sm font-semibold">
            <span class="text-slate-700">Cook County</span>
            <span class="font-bold text-red-600">40–60 min</span>
          </div>
        </div>
        <a href="tel:7736856644" class="btn-primary w-full inline-flex justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.8 19.79 19.79 0 01.0 1.17 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
          Confirm Your Area: (773) 685-6644
        </a>
      </div>

      <div class="lg:col-span-8 reveal-right" style="transition-delay: 0.1s;">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {zones.map((z) => (
            <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs hover:border-red-500 hover:shadow-sm transition-all duration-200 flex items-start justify-between">
              <div>
                <div class="text-sm font-bold text-slate-900 mb-0.5">{z.name}</div>
                <div class="text-xs font-mono text-slate-500">{z.zips}</div>
              </div>
              <div class="w-2.5 h-2.5 rounded-full mt-1.5 flex-shrink-0 bg-emerald-500 shadow-xs"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
