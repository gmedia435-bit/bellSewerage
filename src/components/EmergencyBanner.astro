---
// Top Emergency Bar — Enterprise aesthetic, zero emojis
---

<div class="border-b text-xs font-medium py-2.5 px-4 relative z-50 overflow-hidden" style="background: #080A12; border-color: rgba(255,255,255,0.06); color: var(--slate-2);">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">
    <!-- Live Dispatch Indicator -->
    <div class="flex items-center gap-2.5">
      <span class="inline-flex w-2 h-2 rounded-full" style="background: #22c55e; box-shadow: 0 0 6px #22c55e;"></span>
      <span class="font-semibold tracking-wider uppercase text-white" style="font-size: 0.6875rem; letter-spacing: 0.08em;">
        24-Hour Emergency Dispatch
      </span>
      <span style="color: var(--rule);">|</span>
      <span class="hidden sm:inline font-semibold text-white">
        A Proud 62 Years Family Owned &amp; Operated
      </span>
      <span class="hidden lg:inline" style="color: var(--rule);">|</span>
      <span class="hidden lg:inline font-mono font-bold" style="color: #EF4444;">
        Average Response: 35 Minutes
      </span>
    </div>

    <!-- Credentials & Direct Phone -->
    <div class="flex items-center gap-4 text-xs">
      <span class="hidden md:inline font-mono text-[11px]" style="color: var(--slate-1);">
        IL Lic. Drainlayer #055-043219
      </span>
      <span class="hidden md:inline" style="color: var(--rule);">|</span>
      <a href="tel:7736856644" class="font-bold flex items-center gap-1.5 transition-colors" style="color: #EF4444;" onmouseover="this.style.color='#F87171'" onmouseout="this.style.color='#EF4444'">
        <span>Direct Dispatch: (773) 685-6644</span>
      </a>
    </div>
  </div>
</div>
