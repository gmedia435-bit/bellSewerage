---
import Layout from '../layouts/Layout.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import FieldWorkGallery from '../components/FieldWorkGallery.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import ChicagoFloodDefense from '../components/ChicagoFloodDefense.astro';
import ContractorStandards from '../components/ContractorStandards.astro';
import VerifiedReviews from '../components/VerifiedReviews.astro';
import InstantEstimator from '../components/InstantEstimator.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import FloatingCallBar from '../components/FloatingCallBar.astro';
---

<Layout 
  title="Bell Drainage Co. | 62 Years Family Owned & Operated — Chicago Sewer & Drain"
  description="Licensed Chicago sewer and drain contractor. A proud 62 years family owned and operated. 4,000 PSI hydro-jetting, trenchless CIPP pipe lining, 4K camera diagnostics. 24-hour emergency dispatch. Call (773) 685-6644."
>
  <EmergencyBanner />
  <Header />
  <main>
    <Hero />
    <StatsStrip />
    <ServicesGrid />
    <FieldWorkGallery />
    <BeforeAfterSlider />
    <ChicagoFloodDefense />
    <ContractorStandards />
    <VerifiedReviews />
    <InstantEstimator />
    <ServiceAreaMap />
    <FAQ />
  </main>
  <Footer />
  <FloatingCallBar />
</Layout>
