---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bell Sewerage & Drainage Co. | Chicago Sewer & Drain Specialists — Est. 1955",
  description = "Licensed Chicago sewer and drain contractor serving Cook County since 1955. 4,000 PSI hydro-jetting, trenchless CIPP pipe lining, 4K camera diagnostics. 24-hour emergency response. Call (773) 685-6644."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C0F1A" />

    <!-- Canonical & OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <!-- Favicon SVG -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230C0F1A'/><path d='M16 4C10 4 6 8 6 14c0 8-3 10-3 10h26s-3-2-3-10c0-6-4-10-10-10z' fill='%23C8922A'/><path d='M13 24a3 3 0 006 0' fill='none' stroke='%23C8922A' stroke-width='2'/></svg>" />

    <!-- Fonts: Inter + Instrument Serif -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

    <!-- Local Business Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "PlumbingService",
      "name": "Bell Sewerage & Drainage Co.",
      "telephone": "+17736856644",
      "priceRange": "$$",
      "image": "https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200",
      "description": "Licensed Chicago sewer and drain contractor. Trenchless pipe lining, hydro-jetting, camera diagnostics. 24-hour emergency response.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "6057 W Addison St",
        "addressLocality": "Chicago",
        "addressRegion": "IL",
        "postalCode": "60634",
        "addressCountry": "US"
      },
      "geo": { "@type": "GeoCoordinates", "latitude": 41.9463, "longitude": -87.7788 },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    }
    </script>
  </head>
  <body>
    <!-- Top Scroll Progress Bar -->
    <div id="scroll-progress"></div>

    <slot />

    <!-- Scroll & Reveal Script -->
    <script>
      // Scroll Progress Indicator
      const progressBar = document.getElementById('scroll-progress');
      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY || document.documentElement.scrollTop;
        const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const progress = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
        if (progressBar) {
          progressBar.style.width = `${progress}%`;
        }
      }, { passive: true });

      // Staggered Intersection Observer for Scroll Reveals
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
